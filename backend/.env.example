APP_NAME="ASMARE Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Local dev/test use SQLite. Production uses PostgreSQL (see block below).
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# --- Production PostgreSQL ---
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=asmare
# DB_USERNAME=asmare
# DB_PASSWORD=change-me
# DB_SCHEMA=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# MEDIA LIBRARY
MEDIA_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@asmarebelay.dev"
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_NOTIFY_TELEGRAM=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

SEO_TITLE="ASMARE — Hydrology & Water Resources Engineer"
SEO_DESCRIPTION="Portfolio of a Hydrology & Water Resources Engineer, Lecturer and Researcher."
SEO_KEYWORDS="portfolio, hydrology, water resources, hydrological modeling, gis, remote sensing, researcher"
SEO_IMAGE=

ANALYTICS_ENABLED=true
ANALYTICS_SITE_TOKEN=asmare
ANALYTICS_DOMAIN=asmare.example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Default operator seeded by db:seed (change in production!).
ADMIN_EMAIL=admin@asmarebelay.dev
ADMIN_NAME="ASMARE Admin"
ADMIN_PASSWORD=change-me-now

SANCTUM_STATEFUL_DOMAINS=localhost:5174,localhost:8000

# Absolute URL of the Vue SPA when hosted on a separate origin (e.g. local
# Vite dev server at :5174). Leave empty in production when Nginx serves both.
FRONTEND_URL=

VITE_APP_NAME="${APP_NAME}"
