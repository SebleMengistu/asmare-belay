# ASMARE backend — production env values the Render service needs.
# Render already auto-generates APP_KEY; paste this block as the
# "Environment" variables on the service (skip APP_KEY, it's managed).
APP_NAME="ASMARE Portfolio"
APP_ENV=production
APP_DEBUG=false
APP_URL=

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public
MEDIA_DISK=public

# Must match *one* Vercel origin, or the deployed SPA will be CORS-rejected.
FRONTEND_URL=https://asmare-belay.vercel.app

BROADCAST_CONNECTION=log
LOG_CHANNEL=stack
