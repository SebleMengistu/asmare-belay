# Server
PORT=8000
NODE_ENV=development
APP_NAME="TEFERA Portfolio"
APP_URL=http://localhost:8000
# Allowed browser origin for CORS (the Vue SPA).
FRONTEND_URL=http://localhost:5175

# Database — Postgres / Supabase.
# Preferred: Supabase "Connection string" (project settings -> Database).
# Use the session-pooler (port 5432) URI, e.g.:
#   postgresql://postgres.tefeport:SuperSecret@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Add ?sslmode=require if the provider's connection line includes it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Force SSL on/off (auto-enabled in production / when sslmode=require is in the URL).
# DB_SSL=true

# Local dev example — discrete variables are also accepted (fallback when
# DATABASE_URL is unset):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=postgres

# Legacy SQLite sources — only used by `npm run migrate` (one-time data import).
DB_PATH=./data/portfolio.sqlite
LEGACY_DB_PATH=../backend/database/database.sqlite
LEGACY_STORAGE_PATH=../backend/storage/app/public

# Seeded only when the database has no users.
ADMIN_EMAIL=tefe7ala@gmail.com
ADMIN_NAME="TEFERA Admin"
ADMIN_PASSWORD=change-me

# Analytics intake (mirrors ANALYTICS_ENABLED).
ANALYTICS_ENABLED=true