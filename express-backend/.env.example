# Server
PORT=8000
NODE_ENV=development
APP_NAME="TEFERA Portfolio"
APP_URL=http://localhost:8000
# Allowed browser origin for CORS (the Vue SPA).
FRONTEND_URL=http://localhost:5175

# Database (relative paths are resolved from the express-backend folder).
DB_PATH=./data/portfolio.sqlite
# One-time data import source: when the new DB is empty (no users) and this
# Laravel SQLite file exists, its content is imported on boot.
LEGACY_DB_PATH=../backend/database/database.sqlite
# Root of the Laravel public storage disk (used to copy media files on import).
LEGACY_STORAGE_PATH=../backend/storage/app/public

# Seeded only when there is no legacy database to import from.
ADMIN_EMAIL=tefe7ala@gmail.com
ADMIN_NAME="TEFERA Admin"
ADMIN_PASSWORD=tefe3224

# Analytics intake (mirrors ANALYTICS_ENABLED).
ANALYTICS_ENABLED=true
